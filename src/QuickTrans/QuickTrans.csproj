<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>false</ImplicitUsings>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>QuickTrans</AssemblyName>
    <RootNamespace>QuickTrans</RootNamespace>
    <Version>0.1.8</Version>
    <ApplicationIcon>Assets\QuickTrans.ico</ApplicationIcon>
    <QuickTransUpdateManifestUrl Condition="'$(QuickTransUpdateManifestUrl)' == ''"></QuickTransUpdateManifestUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateManifestUrl" Value="$(QuickTransUpdateManifestUrl)" />
    <Resource Include="Assets\QuickTrans.ico" />
    <Resource Include="Assets\QuickTrans.png" />
  </ItemGroup>
</Project>
